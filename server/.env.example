# Environment
NODE_ENV=production

# Express Server Port
PORT=3001

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://teacherivan.com,https://www.teacherivan.com

# JWT Secret for Session Minting (Min 16 chars, e.g. 48-char random hex)
JWT_SECRET=your_jwt_secret_min_16_chars_here

# Master Gemini API Key for server-side token minting
GEMINI_API_KEY=your_gemini_api_key_here

# Default Live model constraint (optional)
GEMINI_LIVE_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Client ID (Matches client)
GOOGLE_CLIENT_ID=116786083172-q1m93t06euvdsa4tdd6gs9klddhc86i9.apps.googleusercontent.com

# Google Sheets Integration (Authoritative 2-Way Database)
# Option A: Google Apps Script Webhook URL (Zero GCP setup)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_macro_id/exec
# Option B: Google Sheets API v4 Service Account
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Credentials (Optional overrides)
ADMIN_EMAIL=ivan@teacherivan.com
ADMIN_PASSWORD_HASH=
