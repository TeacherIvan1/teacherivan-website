{
  "name": "gemini-live-english-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time Voice English Tutor using Gemini Live API and Ephemeral Tokens",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "test": "npm run test -w client",
    "security:scan": "node scripts/check-secrets.mjs",
    "sau:auth-check": "npm run sau:auth-check --prefix media-pipeline",
    "campaign:audit": "npm run campaign:audit --prefix media-pipeline",
    "campaign:dry-run": "npm run campaign:dry-run --prefix media-pipeline",
    "campaign:stage-queue": "npm run campaign:stage-queue --prefix media-pipeline",
    "campaign:retry-failed": "npm run campaign:retry-failed --prefix media-pipeline"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "ffmpeg-static": "^5.3.0"
  }
}
