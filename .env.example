# ==============================================================================
# Gemini Live Voice Tutor - Server Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Copy this file to `server/.env` (or `.env` in the root)
# - Fill in your GEMINI_API_KEY from Google AI Studio (https://aistudio.google.com)
# - This key remains strictly on the server and is never sent to the browser.
# ==============================================================================

# Your master Gemini API Key (Required on the server)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Default: 3001)
PORT=3001

# Gemini Live Target Model (Optional, defaults to models/gemini-2.5-flash)
GEMINI_LIVE_MODEL=gemini-2.5-flash
