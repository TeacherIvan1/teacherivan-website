# ==============================================================================
# Git Ignore - Teacher Ivan Platform (Root, Server & Client)
# ==============================================================================

# Node dependencies & caches
node_modules/
**/node_modules/
.npm/
.cache/
.temp/

# Build artifacts & distribution
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Environment configurations & local secrets (STRICT - NEVER COMMIT)
.env
.env.*
**/.env
**/.env.*
*.env
*.env.local
*.env.*.local
*.pem
*.key
*.cert
credentials*.json
secrets/

# Allow committed documentation templates
!.env.example
!**/.env.example

# Runtime logs
logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts & generated browser screenshots
screenshot_*.png
**/screenshot_*.png
coverage/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
