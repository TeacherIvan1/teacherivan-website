# ==============================================================================
# Git Ignore - Teacher Ivan Platform (Root, Server & Client)
# ==============================================================================

# Node dependencies & caches
node_modules/
**/node_modules/
.npm/
.cache/
.temp/
.vite/
**/.vite/

# Build artifacts & distribution
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Environment configurations & local secrets (STRICT - NEVER COMMIT)
.env
.env.*
**/.env
**/.env.*
*.env
*.env.local
*.env.*.local
*.pem
*.key
*.cert
credentials*.json
secrets/

# Allow committed documentation templates
!.env.example
!**/.env.example

# Runtime logs
logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts & generated browser screenshots
screenshot*
**/screenshot*
Screenshot*
**/Screenshot*
test-screenshots/
**/test-screenshots/
coverage/

# Local agent skills cache
.agent/
**/.agent/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
look/
**/look/

# Local browser automation profiles
.browser-profile/
**/.browser-profile/

# Non-website media, video pipeline & reference repositories
media-pipeline/
reference-repos/
remotion-reel/
llajta-crossfit-reel/
temp_audio/
scratch/
Reels/
output/
*.mp4
*.mov
*.mkv
*.avi
*.wav
image_*.png
image_*.jpg
WhatsApp*
