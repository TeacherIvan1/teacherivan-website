# ==============================================================================
# Client Environment Variables Template (.env.example)
# Copy this to .env or .env.local for local overrides
# In production (GitHub Actions / Cloud), configure VITE_API_URL
# ==============================================================================

# Express Backend Base URL (defaults to http://localhost:3001 in local dev)
# Example production: https://api.teacherivan.com
VITE_API_URL=http://localhost:3001

# Optional: WebSocket endpoint override for Gemini Live API
# If unset, automatically connects directly to Google Gemini Live API with ephemeral tokens
# VITE_WS_URL=
