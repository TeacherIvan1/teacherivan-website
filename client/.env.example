# ==============================================================================
# Client Environment Variables Template (.env.example)
# Copy this to .env or .env.local for local overrides
# In production (GitHub Actions / Cloud), configure VITE_API_URL & VITE_GOOGLE_CLIENT_ID
# ==============================================================================

# Express Backend Base URL (defaults to http://localhost:3001 in local dev)
# Example production: https://teacherivan-website.onrender.com
VITE_API_URL=http://localhost:3001

# Google OAuth 2.0 Web Client ID (Public identifier)
VITE_GOOGLE_CLIENT_ID=454494230896-b0s8djtejacphfblmiik31nj6roajhch.apps.googleusercontent.com

# Optional: WebSocket endpoint override for Gemini Live API
# If unset, automatically connects directly to Google Gemini Live API with ephemeral tokens
# VITE_WS_URL=

# Optional: Google Analytics 4 Measurement ID (loaded ONLY after user cookie consent)
VITE_GA4_MEASUREMENT_ID=

